# PayOrder W3 Guardian — VPS environment. Copy to `infra/docker/.env.vps` on the VPS and fill
# in. NEVER commit real secrets (only this *.example file is tracked).
#
# NOTE: on the CI-driven deploy path (.github/workflows/ci.yml) this file is RENDERED from
# GitHub Secrets + Variables on every deploy — manual edits there are overwritten. Copying by
# hand is only needed for a manual/first-time deploy.
#
# This file feeds both Compose interpolation (DOCKERHUB_USERNAME, IMAGE_TAG_*, TRAEFIK_NETWORK,
# POSTGRES_*) and the container runtime (env_file). Pass it with
# `--env-file infra/docker/.env.vps`.

# --- Images / Docker Hub (published by .github/workflows/ci.yml) ---
# Docker Hub user/namespace that owns the payorder-api / payorder-web repositories.
DOCKERHUB_USERNAME=guardianlabsw3
# CI deploys pin these to the commit's sha-<short> tag; `latest` is the manual fallback.
IMAGE_TAG_API=latest
IMAGE_TAG_WEB=latest

# --- Existing Traefik (file/directory provider — routes live in
# infra/traefik/payorder_dynamic.toml, which hardcodes the `le` cert resolver and the
# payorder_* container names). WEB_DOMAIN / API_DOMAIN must match the hosts in that toml.
# `proxy` is the shared ingress network created by the other product's stack; confirm the
# real name with `docker network ls`.
TRAEFIK_NETWORK=proxy
WEB_DOMAIN=pow3.guardian-labs.xyz
API_DOMAIN=pow3-api.guardian-labs.xyz

# --- Postgres (isolated) ---
POSTGRES_USER=payorder
POSTGRES_PASSWORD=__set_in_env__
POSTGRES_DB=payorder

# --- API / worker runtime ---
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
# Hosts are the prefixed container names on the private network.
DATABASE_URL=postgres://payorder:__set_in_env__@payorder_postgres:5432/payorder
REDIS_URL=redis://payorder_redis:6379

APP_BASE_URL=https://pow3-api.guardian-labs.xyz
PUBLIC_WEB_URL=https://pow3.guardian-labs.xyz
JWT_SECRET=__set_in_env__
WEBHOOK_SIGNING_SECRET=__set_in_env__
CORS_ORIGINS=https://pow3.guardian-labs.xyz

# --- Admin access ---
# Root admin(s): the ONLY logins that see and manage every tenant; every other admin login is
# scoped to the tenant onboarded under its own email. On the CI deploy this is set to
# SEED_ADMIN_EMAIL automatically. Comma-separated; empty falls back to the app default.
ROOT_ADMIN_EMAIL=admin@pow3.guardian-labs.xyz
# First admin panel account, created once by the `bootstrap-admin` one-shot (idempotent, no
# demo tenant). On the CI deploy these come from GitHub Secrets and are passed at run time —
# they are NOT rendered into this file. Set them here only for a manual bootstrap:
#   docker compose -p payorder -f docker-compose.payorder.vps.yml --env-file .env.vps \
#     run --rm -e SEED_ADMIN_EMAIL -e SEED_ADMIN_PASSWORD bootstrap-admin
# SEED_ADMIN_EMAIL=admin@pow3.guardian-labs.xyz
# SEED_ADMIN_PASSWORD=__set_in_env__

# --- Stellar Testnet ---
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
SOROBAN_CONTRACT_ID=__set_after_deploy__
SOROBAN_ADMIN_SECRET=__set_in_env__
REGISTER_ON_CHAIN_SYNC=false

# --- Frontend (NEXT_PUBLIC_* are baked into payorder-web at CI build time, per environment) ---
NEXT_PUBLIC_API_BASE_URL=https://pow3-api.guardian-labs.xyz
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
# Server-side (SSR) API URL — runtime only, NOT baked into the browser bundle. The public domain
# above may not hairpin back from inside the web container, so SSR reaches the API over the shared
# Traefik network. Use the UNIQUE container name (not a bare `api` alias, which could collide with
# the other product on the shared `proxy` network); the api listens on port 3000.
API_INTERNAL_BASE_URL=http://payorder_api:3000
